rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile + synced settings.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Projects and their source images.
      match /projects/{pid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        match /assets/{aid} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      // Plan, usage and payments are written by the server on the user's behalf and every record carries an HMAC
      // signature ("sig") that only the server can make. The server ignores any record without a valid signature, so a
      // user can never grant themselves Pro. Records can be created and changed but never deleted (no trial reset, and a
      // payment can never be activated twice).
      match /billing/{doc} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.sig is string && request.resource.data.sig.size() == 64;
      }
      match /payments/{pay} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.sig is string && request.resource.data.sig.size() == 64;
      }

      // Checkout sessions the user started (lets "Check payment" work from another device).
      match /checkouts/{cid} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Public release counter (/api/version). Anyone can read it; it can only be created or moved forward.
    match /meta/{doc} {
      allow read: if true;
      allow create, update: if doc == 'version'
        && request.resource.data.keys().hasOnly(['base', 'patch', 'version', 'buildId', 'at', 'note', 'history'])
        && request.resource.data.patch is int && request.resource.data.patch < 1000000
        && request.resource.data.history.size() <= 200
        && (resource == null || request.resource.data.patch >= resource.data.patch);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
